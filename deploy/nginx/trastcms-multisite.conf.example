# TrastCMS 3.4.0 · ejemplo multisite
# Copie en /etc/nginx/conf.d/trastcms.conf o adapte a sites-available.

upstream trastcms_backend {
    server 127.0.0.1:8080;
    keepalive 32;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Sitio principal
server {
    listen 80;
    server_name tours.example.com www.tours.example.com;

    client_max_body_size 550m;

    location / {
        proxy_pass http://trastcms_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

